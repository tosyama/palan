export func graphemeProps(int32 c) -> uint8
{
	int64 lo = 0, hi = 2183;
	while hi - lo > 1 {
		int64 mid = (lo + hi) / 2;
		if starts[mid] <= c { mid -> lo; } else { mid -> hi; }
	}
	return props[lo];
}

export func gcbOf(uint8 p) -> gcbProp { return gcbProp(p & 15); }
export func isExtPict(uint8 p) -> bool { return (p & 16) != 0; }
export func incbOf(uint8 p) -> incbProp { return incbProp(p >>> 5); }

func check(int32 c, uint8 p)
{
	if graphemeProps(c) != p {
		printf("graphemeProps(0x%X) is 0x%02X, not 0x%02X\n", c, graphemeProps(c), p);
		exit(1);
	}
}

