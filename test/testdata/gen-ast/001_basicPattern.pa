import "lib_basic.pa" as lib;
import twice from "lib_basic.pa";
cinclude <stdio.h>;

const N = 4;

export type Point { int32 x; int32 y; };
type Color enum { RED, GREEN = 5, BLUE };
type Count = int64;
export type Handle = opaque Point;

global int64 calls = 0 for norm1!;

func norm1(@Point p) -> int32 {
	calls + 1 -> calls;
	return p.x + p.y;
}

func divmod(int32 a, b) -> int32 q, int32 r {
	a / b -> q;
	a % b -> r;
}

export func scale(@![N]int32 v, int32 k = 2) {
	for @!e in v { e * k -> e; }
}

cexport func grow([+]int32 v) -> [+]int32 {
	v.push(int32(len(@v)));
	return v;
}

int64 x = 10, y = x + 3;
Count c = y;
Color col = Color.GREEN;
[N]int32 a = [1, 2, 3, 4];
[+]int32 v = [5, 6];
$Point p = {x: 1, y: 2};
Point q;
[""]int32 stock = {"apple": 3, N: 4};
p -> q;
(int32 qq, rr) = divmod(17, 5);
divmod(9, 4) -> (qq, a[0]);
scale(@!a, 3);
@!a -> scale();
v ->> grow() ->> v;
if x > y {
	printf("big\n");
} else {
	printf("small\n");
}
while x > 0 {
	x - 1 -> x;
	if x == 5 { break; }
}
for copy e, i in v { printf("%ld:%d ", i, e); }
printf("%d %ld %ld %ld\n", norm1(@q), lib.half(c), twice(x), calls);
