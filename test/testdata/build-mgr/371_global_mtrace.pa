cinclude <stdio.h>;
cinclude <mcheck.h>;
func trace() -> int32 { mtrace(); return 1; }
global int32 tracing = trace();
global [3]int32 a = [1, 2, 3] for sum;
func sum() -> int32 s {
    0 -> s;
    for copy e in a { s + e -> s; }
}
printf("%d\n", sum());
[3]int32 b = [4, 5, 6];
b ->> a;
printf("%d\n", sum());
muntrace();
