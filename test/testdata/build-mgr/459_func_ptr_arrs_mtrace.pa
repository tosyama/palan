cinclude <stdio.h>;
cinclude <mcheck.h>;
import "lib_func_ptr_arrs.pa";
func fill(@![2]$[3]int32 m) { 5 -> m[1][2]; }
func at(@[]$[3]int32 m) -> int32 { return m[1][2]; }
func second(@[]int32 v) -> int32 { return v[1]; }
func count(@[+]int32 v) -> int64 { return len(v); }
func add(@![""]int32 d) -> @![""]int32 { 2 -> d["b"]; return d; }
func total([""]$P d) -> int32 { return d["k"].x; }
func f() {
	O o = make();
	[+]P v;
	printf("%ld ", size(@o, @!v));
	@![+]P w = o.g(@!v);
	printf("%ld %d\n", len(w), w[1].x);
	for copy p in o.g(@!v) { printf("%d ", p.x); }
	[""]P d;
	P p = {x: 3};
	p ->> d["k"];
	[""]P e = o.d(d>>);
	printf("%d\n", e["k"].x);
	[3]int32 a = [1, 2, 3];
	@![3]int32 b = o.a(@!a);
	8 -> b[0];
	@func(@[3]int32) -> int32 s = second;
	printf("%d %d %d %d\n", a[0], a[2], s(@a), s(@[4, 5, 6]));
	@func(@![2]$[3]int32) g = fill;
	@func(@[]$[3]int32) -> int32 h = at;
	[2]$[3]int32 m;
	g(@!m);
	[2]@func(@![+]int32) -> int64 cs;
	count -> cs[1];
	@func(@![+]int32) -> int64 c1 = cs[1];
	[+]int32 c = [1, 2];
	@func(@![""]int32) -> @![""]int32 ad = add;
	[""]int32 i = {"a": 1};
	3 -> ad(@!i)["c"];
	@func([""]$P) -> int32 t = total;
	printf("%d %ld %ld %d\n", h(@m), c1(@!c), len(@i), t({"k": {x: 7}}));
}
mtrace();
f();
