cinclude <stdio.h>;
cinclude "356_c_bitfield.h" link "356_c_bitfield.o";

layout();

Bf f;
1 -> f.c; 2 -> f.d; 3 -> f.f;
set_bf(@!f);
show_bf(@f);
printf("%d %d %d / %ld %ld\n", f.c, f.d, f.f,
	(@f.d as int64) - (@f.c as int64), (@f.f as int64) - (@f.c as int64));

Bp p;
4 -> p.c; 5 -> p.d;
show_bp(p);
printf("%ld\n", (@p.d as int64) - (@p.c as int64));

Bl l;
6 -> l.c;
show_bl(@l);
printf("%ld\n", (@l.c as int64) - (@l as int64));

Bs s;
1.5 -> s.x; 2.5 -> s.y;
show_bs(s);
Bs r = make_bs();
printf("%.2f %.2f\n", r.x, r.y);
show_bs(r);

// Palan reads what C set, and writes beside the other fields of each unit.
printf("%u %u %d\n", f.a, f.b, f.e);
5 -> f.a; 63 -> f.b; 3 -> f.e;
show_bf(@f);
uint32 big = 100;
int16 three = 5;
big -> f.a; three -> f.e;
show_bf(@f);
printf("%u %d\n", f.a, f.e);

-1000 -> p.a;
show_bp(p);
printf("%d\n", p.a);

-5 -> l.a; 1000 -> l.b;
show_bl(@l);
printf("%ld %d\n", l.a, l.b);

Bs t = [0.5, -100, 0.75];
show_bs(t);
printf("%d %d\n", t.a, r.a);
